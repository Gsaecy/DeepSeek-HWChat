{
  "name": "hwchat",
  "displayName": "HWChat",
  "description": "A secure coding agent for VS Code with DeepSeek: approval-controlled workspace tools, plan-tracking task lists, copyable local/server commands and durable local history.",
  "version": "0.3.2",
  "publisher": "honor-world",
  "license": "MIT",
  "icon": "resources/logo.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/Gsaecy/DeepSeek-HWChat"
  },
  "engines": {
    "vscode": "^1.106.0"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "%capability.untrustedWorkspaces%",
      "restrictedConfigurations": [
        "hwchat.permissionPreset",
        "hwchat.fileReadPolicy",
        "hwchat.fileWritePolicy",
        "hwchat.commandPolicy",
        "hwchat.dangerousCommandPolicy",
        "hwchat.sensitiveFilePolicy"
      ]
    }
  },
  "categories": [
    "AI",
    "Chat"
  ],
  "keywords": [
    "deepseek",
    "chat",
    "ai",
    "llm",
    "reasoner",
    "assistant"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "hwchat.openChat",
        "title": "HWChat: %command.openChat%",
        "category": "HWChat",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "hwchat.newChat",
        "title": "HWChat: %command.newChat%",
        "category": "HWChat",
        "icon": "$(add)"
      },
      {
        "command": "hwchat.openSettings",
        "title": "HWChat: %command.openSettings%",
        "category": "HWChat",
        "icon": "$(settings-gear)"
      },
      {
        "command": "hwchat.askSelection",
        "title": "HWChat: %command.askSelection%",
        "category": "HWChat"
      },
      {
        "command": "hwchat.explainSelection",
        "title": "HWChat: %command.explainSelection%",
        "category": "HWChat"
      },
      {
        "command": "hwchat.cleanupNow",
        "title": "HWChat: %command.cleanupNow%",
        "category": "HWChat",
        "icon": "$(trash)"
      },
      {
        "command": "hwchat.setApiKey",
        "title": "HWChat: %command.setApiKey%",
        "category": "HWChat"
      },
      {
        "command": "hwchat.exportHistory",
        "title": "HWChat: %command.exportHistory%",
        "category": "HWChat",
        "icon": "$(export)"
      },
      {
        "command": "hwchat.attachFiles",
        "title": "HWChat: %command.attachFiles%",
        "category": "HWChat",
        "icon": "$(attach)"
      },
      {
        "command": "hwchat.archiveConversation",
        "title": "HWChat: %command.archiveConversation%",
        "category": "HWChat",
        "icon": "$(archive)"
      },
      {
        "command": "hwchat.continueConversation",
        "title": "HWChat: %command.continueConversation%",
        "category": "HWChat",
        "icon": "$(debug-step-over)"
      },
      {
        "command": "hwchat.rescanSkills",
        "title": "HWChat: %command.rescanSkills%",
        "category": "HWChat",
        "icon": "$(refresh)"
      },
      {
        "command": "hwchat.syncVsCodeApprovals",
        "title": "HWChat: %command.syncVsCodeApprovals%",
        "category": "HWChat",
        "icon": "$(shield)"
      },
      {
        "command": "hwchat.revertVsCodeApprovals",
        "title": "HWChat: %command.revertVsCodeApprovals%",
        "category": "HWChat",
        "icon": "$(discard)"
      },
      {
        "command": "hwchat.showPermissionScope",
        "title": "HWChat: %command.showPermissionScope%",
        "category": "HWChat",
        "icon": "$(eye)"
      },
      {
        "command": "hwchat.showResourceStats",
        "title": "HWChat: %command.showResourceStats%",
        "category": "HWChat",
        "icon": "$(pulse)"
      }
    ],
    "viewsContainers": {
      "secondarySidebar": [
        {
          "id": "hwchat",
          "title": "HWChat",
          "icon": "resources/activity.svg"
        }
      ]
    },
    "views": {
      "hwchat": [
        {
          "type": "webview",
          "id": "hwchat.chatView",
          "name": "HWChat",
          "initialSize": 420
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "hwchat.chatView",
        "contents": "%viewsWelcome.chat%"
      }
    ],
    "keybindings": [
      {
        "command": "hwchat.openChat",
        "key": "cmd+shift+l",
        "mac": "cmd+shift+l",
        "win": "ctrl+shift+l",
        "linux": "ctrl+shift+l"
      },
      {
        "command": "hwchat.askSelection",
        "key": "cmd+alt+.",
        "mac": "cmd+alt+.",
        "win": "ctrl+alt+.",
        "linux": "ctrl+alt+."
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "hwchat.askSelection",
          "when": "editorHasSelection",
          "group": "hwchat@1"
        },
        {
          "command": "hwchat.explainSelection",
          "when": "editorHasSelection",
          "group": "hwchat@2"
        }
      ],
      "explorer/context": [
        {
          "command": "hwchat.attachFiles",
          "when": "resourceScheme == file",
          "group": "hwchat@1"
        }
      ],
      "view/title": [
        {
          "command": "hwchat.newChat",
          "when": "view == hwchat.chatView",
          "group": "navigation@1"
        },
        {
          "command": "hwchat.openSettings",
          "when": "view == hwchat.chatView",
          "group": "navigation@2"
        }
      ]
    },
    "configuration": {
      "title": "HWChat",
      "properties": {
        "hwchat.apiProfiles": {
          "type": "array",
          "default": [],
          "description": "%config.apiProfiles%",
          "items": {
            "type": "object",
            "required": [
              "id",
              "name",
              "baseUrl",
              "models"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "baseUrl": {
                "type": "string"
              },
              "models": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "excludedModels": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "requestHeaders": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              }
            }
          }
        },
        "hwchat.activeApiProfileId": {
          "type": "string",
          "default": "default",
          "description": "%config.activeApiProfileId%"
        },
        "hwchat.baseUrl": {
          "type": "string",
          "default": "https://api.deepseek.com",
          "markdownDescription": "%config.baseUrl%"
        },
        "hwchat.model": {
          "type": "string",
          "default": "deepseek-flash",
          "description": "%config.model%"
        },
        "hwchat.requestHeaders": {
          "type": "object",
          "default": {},
          "additionalProperties": {
            "type": "string"
          },
          "description": "%config.requestHeaders%"
        },
        "hwchat.requestTimeoutSeconds": {
          "type": "number",
          "default": 120,
          "minimum": 10,
          "maximum": 900,
          "description": "%config.requestTimeoutSeconds%"
        },
        "hwchat.temperature": {
          "type": "number",
          "default": 1,
          "minimum": 0,
          "maximum": 2,
          "description": "%config.temperature%"
        },
        "hwchat.maxTokens": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "description": "%config.maxTokens%"
        },
        "hwchat.systemPrompt": {
          "type": "string",
          "editPresentation": "multilineText",
          "default": "",
          "description": "%config.systemPrompt%"
        },
        "hwchat.sendOnEnter": {
          "type": "boolean",
          "default": true,
          "description": "%config.sendOnEnter%"
        },
        "hwchat.historyRetentionDays": {
          "type": "number",
          "default": 30,
          "minimum": 0,
          "description": "%config.historyRetentionDays%"
        },
        "hwchat.taskCacheRetentionHours": {
          "type": "number",
          "default": 24,
          "minimum": 0,
          "description": "%config.taskCacheRetentionHours%"
        },
        "hwchat.cacheBudgetMB": {
          "type": "number",
          "default": 100,
          "minimum": 5,
          "description": "%config.cacheBudgetMB%"
        },
        "hwchat.cleanupIntervalMinutes": {
          "type": "number",
          "default": 10,
          "minimum": 1,
          "description": "%config.cleanupIntervalMinutes%"
        },
        "hwchat.maxMessagesInContext": {
          "type": "number",
          "default": 20,
          "minimum": 0,
          "description": "%config.maxMessagesInContext%"
        },
        "hwchat.defaultMode": {
          "type": "string",
          "enum": [
            "chat",
            "agent",
            "plan"
          ],
          "enumDescriptions": [
            "%config.defaultMode.enum0%",
            "%config.defaultMode.enum1%",
            "%config.defaultMode.enum2%"
          ],
          "default": "agent",
          "description": "%config.defaultMode%"
        },
        "hwchat.agentMaxSteps": {
          "type": "number",
          "default": 24,
          "minimum": 0,
          "maximum": 200,
          "description": "%config.agentMaxSteps%",
          "deprecationMessage": "%config.agentMaxSteps.deprecated%"
        },
        "hwchat.searchExclude": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "scope": "resource",
          "description": "%config.searchExclude%"
        },
        "hwchat.reasoningEffort": {
          "type": "string",
          "enum": [
            "default",
            "low",
            "medium",
            "high",
            "max"
          ],
          "enumDescriptions": [
            "%config.reasoningEffort.enumDefault%",
            "%config.reasoningEffort.enum0%",
            "%config.reasoningEffort.enum1%",
            "%config.reasoningEffort.enum2%",
            "%config.reasoningEffort.enum3%"
          ],
          "default": "default",
          "description": "%config.reasoningEffort%",
          "deprecationMessage": "%config.reasoningEffort.deprecated%"
        },
        "hwchat.permissionPreset": {
          "type": "string",
          "scope": "resource",
          "enum": [
            "askAll",
            "review",
            "autopilot",
            "full"
          ],
          "enumDescriptions": [
            "%config.permissionPreset.enum0%",
            "%config.permissionPreset.enum1%",
            "%config.permissionPreset.enum2%",
            "%config.permissionPreset.enum3%"
          ],
          "default": "askAll",
          "description": "%config.permissionPreset%",
          "deprecationMessage": "%config.permissionPreset.deprecated%"
        },
        "hwchat.fileReadPolicy": {
          "type": "string",
          "scope": "resource",
          "enum": [
            "allow",
            "ask",
            "deny"
          ],
          "default": "allow",
          "deprecationMessage": "%config.fileReadPolicy.deprecated%",
          "description": "%config.fileReadPolicy%"
        },
        "hwchat.fileWritePolicy": {
          "type": "string",
          "scope": "resource",
          "enum": [
            "allow",
            "ask",
            "deny"
          ],
          "default": "ask",
          "deprecationMessage": "%config.fileWritePolicy.deprecated%",
          "description": "%config.fileWritePolicy%"
        },
        "hwchat.commandPolicy": {
          "type": "string",
          "scope": "resource",
          "enum": [
            "allow",
            "ask",
            "deny"
          ],
          "default": "ask",
          "deprecationMessage": "%config.commandPolicy.deprecated%",
          "description": "%config.commandPolicy%"
        },
        "hwchat.dangerousCommandPolicy": {
          "type": "string",
          "scope": "resource",
          "enum": [
            "allow",
            "ask",
            "deny"
          ],
          "enumDescriptions": [
            "%config.dangerousCommandPolicy.enum0%",
            "%config.dangerousCommandPolicy.enum1%",
            "%config.dangerousCommandPolicy.enum2%"
          ],
          "default": "ask",
          "deprecationMessage": "%config.dangerousCommandPolicy.deprecated%",
          "description": "%config.dangerousCommandPolicy%"
        },
        "hwchat.sensitiveFilePolicy": {
          "type": "string",
          "scope": "resource",
          "enum": [
            "allow",
            "ask",
            "deny"
          ],
          "enumDescriptions": [
            "%config.sensitiveFilePolicy.enum0%",
            "%config.sensitiveFilePolicy.enum1%",
            "%config.sensitiveFilePolicy.enum2%"
          ],
          "default": "deny",
          "deprecationMessage": "%config.sensitiveFilePolicy.deprecated%",
          "description": "%config.sensitiveFilePolicy%"
        },
        "hwchat.allowSensitiveFiles": {
          "type": "boolean",
          "default": false,
          "deprecationMessage": "%config.allowSensitiveFiles.deprecated%",
          "description": "%config.allowSensitiveFiles%"
        },
        "hwchat.allowDangerousCommands": {
          "type": "boolean",
          "default": false,
          "deprecationMessage": "%config.allowDangerousCommands.deprecated%",
          "description": "%config.allowDangerousCommands%"
        },
        "hwchat.maxReadBytes": {
          "type": "number",
          "default": 512000,
          "minimum": 16384,
          "maximum": 5242880,
          "description": "%config.maxReadBytes%"
        },
        "hwchat.maxToolOutputBytes": {
          "type": "number",
          "default": 200000,
          "minimum": 16384,
          "maximum": 2097152,
          "description": "%config.maxToolOutputBytes%"
        },
        "hwchat.maxCommandSeconds": {
          "type": "number",
          "default": 120,
          "minimum": 5,
          "maximum": 900,
          "description": "%config.maxCommandSeconds%"
        },
        "hwchat.auditRetentionDays": {
          "type": "number",
          "default": 30,
          "minimum": 0,
          "maximum": 365,
          "description": "%config.auditRetentionDays%"
        },
        "hwchat.language": {
          "type": "string",
          "enum": [
            "auto",
            "zh",
            "en"
          ],
          "enumDescriptions": [
            "%config.language.enum0%",
            "%config.language.enum1%",
            "%config.language.enum2%"
          ],
          "default": "auto",
          "description": "%config.language%"
        }
      }
    }
  },
  "scripts": {
    "check": "tsc -p ./ --noEmit",
    "compile": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "test": "npm run compile && node --test out/test/*.test.js",
    "package": "npm run compile && node scripts/third-party-notices.mjs && npx @vscode/vsce package --no-dependencies",
    "vscode:prepublish": "npm run compile",
    "notices": "node scripts/third-party-notices.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/vscode": "^1.106.0",
    "@vscode/vsce": "4.0.0",
    "esbuild": "^0.28.0",
    "typescript": "^5.7.0"
  },
  "dependencies": {
    "defuddle": "^0.19.6"
  }
}
