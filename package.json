{
  "name": "plaitcode",
  "displayName": "PlaitCode",
  "description": "A secure coding agent for VS Code with DeepSeek: approval-controlled workspace tools, plan-tracking task lists, copyable local/server commands and durable local history.",
  "version": "0.5.0",
  "publisher": "plaitcode",
  "license": "MIT",
  "icon": "resources/logo.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/Gsaecy/PlaitCode"
  },
  "engines": {
    "vscode": "^1.106.0"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "%capability.untrustedWorkspaces%",
      "restrictedConfigurations": [
        "plaitcode.permissionPreset",
        "plaitcode.fileReadPolicy",
        "plaitcode.fileWritePolicy",
        "plaitcode.commandPolicy",
        "plaitcode.dangerousCommandPolicy",
        "plaitcode.sensitiveFilePolicy",
        "plaitcode.apiProfiles",
        "plaitcode.activeApiProfileId",
        "plaitcode.baseUrl",
        "plaitcode.requestHeaders",
        "plaitcode.proxy",
        "plaitcode.proxyBypassHosts",
        "plaitcode.systemPrompt",
        "plaitcode.allowSensitiveFiles",
        "plaitcode.allowDangerousCommands",
        "plaitcode.maxReadBytes",
        "plaitcode.maxToolOutputBytes",
        "plaitcode.maxCommandSeconds",
        "plaitcode.historyRetentionDays",
        "plaitcode.taskCacheRetentionHours",
        "plaitcode.cacheBudgetMB",
        "plaitcode.cleanupIntervalMinutes",
        "plaitcode.auditRetentionDays",
        "plaitcode.embeddingProfileId",
        "plaitcode.embeddingModel",
        "plaitcode.embeddingBaseUrl"
      ]
    }
  },
  "categories": [
    "AI",
    "Chat"
  ],
  "keywords": [
    "deepseek",
    "chat",
    "ai",
    "llm",
    "reasoner",
    "assistant"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "plaitcode.openChat",
        "title": "PlaitCode: %command.openChat%",
        "category": "PlaitCode",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "plaitcode.newChat",
        "title": "PlaitCode: %command.newChat%",
        "category": "PlaitCode",
        "icon": "$(add)"
      },
      {
        "command": "plaitcode.openSettings",
        "title": "PlaitCode: %command.openSettings%",
        "category": "PlaitCode",
        "icon": "$(settings-gear)"
      },
      {
        "command": "plaitcode.askSelection",
        "title": "PlaitCode: %command.askSelection%",
        "category": "PlaitCode"
      },
      {
        "command": "plaitcode.explainSelection",
        "title": "PlaitCode: %command.explainSelection%",
        "category": "PlaitCode"
      },
      {
        "command": "plaitcode.cleanupNow",
        "title": "PlaitCode: %command.cleanupNow%",
        "category": "PlaitCode",
        "icon": "$(trash)"
      },
      {
        "command": "plaitcode.restoreDeletedConversations",
        "title": "PlaitCode: %command.restoreDeletedConversations%",
        "category": "PlaitCode"
      },
      {
        "command": "plaitcode.emptyTrash",
        "title": "PlaitCode: %command.emptyTrash%",
        "category": "PlaitCode"
      },
      {
        "command": "plaitcode.setApiKey",
        "title": "PlaitCode: %command.setApiKey%",
        "category": "PlaitCode"
      },
      {
        "command": "plaitcode.exportHistory",
        "title": "PlaitCode: %command.exportHistory%",
        "category": "PlaitCode",
        "icon": "$(export)"
      },
      {
        "command": "plaitcode.attachFiles",
        "title": "PlaitCode: %command.attachFiles%",
        "category": "PlaitCode",
        "icon": "$(attach)"
      },
      {
        "command": "plaitcode.archiveConversation",
        "title": "PlaitCode: %command.archiveConversation%",
        "category": "PlaitCode",
        "icon": "$(archive)"
      },
      {
        "command": "plaitcode.continueConversation",
        "title": "PlaitCode: %command.continueConversation%",
        "category": "PlaitCode",
        "icon": "$(debug-step-over)"
      },
      {
        "command": "plaitcode.rescanSkills",
        "title": "PlaitCode: %command.rescanSkills%",
        "category": "PlaitCode",
        "icon": "$(refresh)"
      },
      {
        "command": "plaitcode.syncVsCodeApprovals",
        "title": "PlaitCode: %command.syncVsCodeApprovals%",
        "category": "PlaitCode",
        "icon": "$(shield)"
      },
      {
        "command": "plaitcode.revertVsCodeApprovals",
        "title": "PlaitCode: %command.revertVsCodeApprovals%",
        "category": "PlaitCode",
        "icon": "$(discard)"
      },
      {
        "command": "plaitcode.showPermissionScope",
        "title": "PlaitCode: %command.showPermissionScope%",
        "category": "PlaitCode",
        "icon": "$(eye)"
      },
      {
        "command": "plaitcode.showResourceStats",
        "title": "PlaitCode: %command.showResourceStats%",
        "category": "PlaitCode",
        "icon": "$(pulse)"
      },
      {
        "command": "plaitcode.diagnoseNetwork",
        "title": "PlaitCode: %command.diagnoseNetwork%",
        "category": "PlaitCode"
      },
      {
        "command": "plaitcode.lanSync.status",
        "title": "PlaitCode: 查看局域网同步状态"
      },
      {
        "command": "plaitcode.lanSync.openLedger",
        "title": "PlaitCode: 打开跨平台对齐账本"
      },
      {
        "command": "plaitcode.lanSync.connect",
        "title": "PlaitCode: 连接另一台设备（同一 WiFi，一键）",
        "icon": "$(broadcast)"
      },
      {
        "command": "plaitcode.lanSync.disconnect",
        "title": "PlaitCode: 断开局域网同步"
      },
      {
        "command": "plaitcode.lanSync.advanced",
        "title": "PlaitCode: 局域网同步 · 高级设置"
      },
      {
        "command": "plaitcode.lanSync.openGroup",
        "title": "PlaitCode: 打开团队群（甲方与两个乙方）",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "plaitcode.mobile.open",
        "title": "PlaitCode: 手机遥控（扫码）",
        "icon": "$(device-mobile)"
      },
      {
        "command": "plaitcode.mobile.toggle",
        "title": "PlaitCode: 开 / 关手机遥控"
      }
    ],
    "viewsContainers": {
      "secondarySidebar": [
        {
          "id": "plaitcode",
          "title": "PlaitCode",
          "icon": "resources/activity.svg"
        }
      ]
    },
    "views": {
      "plaitcode": [
        {
          "type": "webview",
          "id": "plaitcode.chatView",
          "name": "PlaitCode",
          "initialSize": 420
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "plaitcode.chatView",
        "contents": "%viewsWelcome.chat%"
      }
    ],
    "keybindings": [
      {
        "command": "plaitcode.openChat",
        "key": "cmd+shift+l",
        "mac": "cmd+shift+l",
        "win": "ctrl+shift+l",
        "linux": "ctrl+shift+l"
      },
      {
        "command": "plaitcode.askSelection",
        "key": "cmd+alt+.",
        "mac": "cmd+alt+.",
        "win": "ctrl+alt+.",
        "linux": "ctrl+alt+."
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "plaitcode.askSelection",
          "when": "editorHasSelection",
          "group": "plaitcode@1"
        },
        {
          "command": "plaitcode.explainSelection",
          "when": "editorHasSelection",
          "group": "plaitcode@2"
        }
      ],
      "explorer/context": [
        {
          "command": "plaitcode.attachFiles",
          "when": "resourceScheme == file",
          "group": "plaitcode@1"
        }
      ],
      "view/title": [
        {
          "command": "plaitcode.lanSync.connect",
          "when": "view == plaitcode.chatView",
          "group": "navigation@0"
        },
        {
          "command": "plaitcode.lanSync.openGroup",
          "when": "view == plaitcode.chatView",
          "group": "navigation@0"
        },
        {
          "command": "plaitcode.newChat",
          "when": "view == plaitcode.chatView",
          "group": "navigation@1"
        },
        {
          "command": "plaitcode.openSettings",
          "when": "view == plaitcode.chatView",
          "group": "navigation@2"
        }
      ]
    },
    "configuration": {
      "title": "PlaitCode",
      "properties": {
        "plaitcode.apiProfiles": {
          "type": "array",
          "default": [],
          "description": "%config.apiProfiles%",
          "items": {
            "type": "object",
            "required": [
              "id",
              "name",
              "baseUrl",
              "models"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "baseUrl": {
                "type": "string"
              },
              "models": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "excludedModels": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "imageModel": {
                "type": "string",
                "description": "%config.apiProfileImageModel%"
              },
              "requestHeaders": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              }
            }
          },
          "scope": "machine"
        },
        "plaitcode.activeApiProfileId": {
          "type": "string",
          "default": "default",
          "description": "%config.activeApiProfileId%",
          "scope": "machine"
        },
        "plaitcode.baseUrl": {
          "type": "string",
          "default": "https://api.deepseek.com",
          "markdownDescription": "%config.baseUrl%",
          "scope": "machine"
        },
        "plaitcode.model": {
          "type": "string",
          "default": "deepseek-flash",
          "description": "%config.model%"
        },
        "plaitcode.requestHeaders": {
          "type": "object",
          "default": {},
          "additionalProperties": {
            "type": "string"
          },
          "description": "%config.requestHeaders%",
          "scope": "machine"
        },
        "plaitcode.requestTimeoutSeconds": {
          "type": "number",
          "default": 120,
          "minimum": 10,
          "maximum": 900,
          "description": "%config.requestTimeoutSeconds%"
        },
        "plaitcode.proxy": {
          "type": "string",
          "default": "",
          "description": "%config.proxy%",
          "markdownDescription": "%config.proxy%",
          "scope": "machine"
        },
        "plaitcode.proxyBypassHosts": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "api.deepseek.com"
          ],
          "description": "%config.proxyBypassHosts%",
          "markdownDescription": "%config.proxyBypassHosts%",
          "scope": "machine"
        },
        "plaitcode.embeddingProfileId": {
          "type": "string",
          "default": "",
          "description": "%config.embeddingProfileId%",
          "markdownDescription": "%config.embeddingProfileId%",
          "scope": "machine"
        },
        "plaitcode.embeddingModel": {
          "type": "string",
          "default": "",
          "description": "%config.embeddingModel%",
          "markdownDescription": "%config.embeddingModel%",
          "scope": "machine"
        },
        "plaitcode.embeddingBaseUrl": {
          "type": "string",
          "default": "",
          "description": "%config.embeddingBaseUrl%",
          "markdownDescription": "%config.embeddingBaseUrl%",
          "scope": "machine"
        },
        "plaitcode.temperature": {
          "type": "number",
          "default": 1,
          "minimum": 0,
          "maximum": 2,
          "description": "%config.temperature%"
        },
        "plaitcode.maxTokens": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "description": "%config.maxTokens%"
        },
        "plaitcode.systemPrompt": {
          "type": "string",
          "editPresentation": "multilineText",
          "default": "",
          "description": "%config.systemPrompt%",
          "scope": "machine"
        },
        "plaitcode.sendOnEnter": {
          "type": "boolean",
          "default": true,
          "description": "%config.sendOnEnter%"
        },
        "plaitcode.historyRetentionDays": {
          "type": "number",
          "default": 30,
          "minimum": 0,
          "description": "%config.historyRetentionDays%",
          "scope": "machine"
        },
        "plaitcode.taskCacheRetentionHours": {
          "type": "number",
          "default": 24,
          "minimum": 0,
          "description": "%config.taskCacheRetentionHours%",
          "scope": "machine"
        },
        "plaitcode.cacheBudgetMB": {
          "type": "number",
          "default": 100,
          "minimum": 5,
          "description": "%config.cacheBudgetMB%",
          "scope": "machine"
        },
        "plaitcode.cleanupIntervalMinutes": {
          "type": "number",
          "default": 10,
          "minimum": 1,
          "description": "%config.cleanupIntervalMinutes%",
          "scope": "machine"
        },
        "plaitcode.maxMessagesInContext": {
          "type": "number",
          "default": 20,
          "minimum": 0,
          "description": "%config.maxMessagesInContext%"
        },
        "plaitcode.defaultMode": {
          "type": "string",
          "enum": [
            "chat",
            "agent",
            "plan"
          ],
          "enumDescriptions": [
            "%config.defaultMode.enum0%",
            "%config.defaultMode.enum1%",
            "%config.defaultMode.enum2%"
          ],
          "default": "agent",
          "description": "%config.defaultMode%"
        },
        "plaitcode.agentMaxSteps": {
          "type": "number",
          "default": 24,
          "minimum": 0,
          "maximum": 200,
          "description": "%config.agentMaxSteps%",
          "deprecationMessage": "%config.agentMaxSteps.deprecated%"
        },
        "plaitcode.searchExclude": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "scope": "resource",
          "description": "%config.searchExclude%"
        },
        "plaitcode.reasoningEffort": {
          "type": "string",
          "enum": [
            "default",
            "low",
            "medium",
            "high",
            "max"
          ],
          "enumDescriptions": [
            "%config.reasoningEffort.enumDefault%",
            "%config.reasoningEffort.enum0%",
            "%config.reasoningEffort.enum1%",
            "%config.reasoningEffort.enum2%",
            "%config.reasoningEffort.enum3%"
          ],
          "default": "default",
          "description": "%config.reasoningEffort%",
          "deprecationMessage": "%config.reasoningEffort.deprecated%"
        },
        "plaitcode.projectDoc": {
          "type": "string",
          "enum": [
            "auto",
            "ask",
            "off"
          ],
          "enumDescriptions": [
            "自动维护：真的改过项目文件之后，由 PlaitCode 建立并追加项目技术文档（推荐）",
            "每次写入前确认",
            "关闭：不建立、不追加、不注入项目技术文档"
          ],
          "default": "auto",
          "scope": "machine",
          "markdownDescription": "项目技术文档（`docs/PLAITCODE-PROJECT-NOTES.md`，没有 `docs/` 时放项目根）。**唯一一份、只追加不重写**，随项目一起提交，用来让早期决策在长对话或新对话里不丢。只在 PlaitCode 真的改过该项目文件之后才会建立。\n\n这是权限预设之外**唯一一个**会改变「要不要问」的开关，所以它在设置页单独列一行，且是 machine 作用域（克隆下来的仓库不能靠 `.vscode/settings.json` 替你打开它）。"
        },
        "plaitcode.permissionPreset": {
          "type": "string",
          "scope": "machine",
          "enum": [
            "askAll",
            "review",
            "autopilot",
            "full"
          ],
          "enumDescriptions": [
            "%config.permissionPreset.enum0%",
            "%config.permissionPreset.enum1%",
            "%config.permissionPreset.enum2%",
            "%config.permissionPreset.enum3%"
          ],
          "default": "askAll",
          "description": "%config.permissionPreset%",
          "deprecationMessage": "%config.permissionPreset.deprecated%"
        },
        "plaitcode.fileReadPolicy": {
          "type": "string",
          "scope": "machine",
          "enum": [
            "allow",
            "ask",
            "deny"
          ],
          "default": "allow",
          "deprecationMessage": "%config.fileReadPolicy.deprecated%",
          "description": "%config.fileReadPolicy%"
        },
        "plaitcode.fileWritePolicy": {
          "type": "string",
          "scope": "machine",
          "enum": [
            "allow",
            "ask",
            "deny"
          ],
          "default": "ask",
          "deprecationMessage": "%config.fileWritePolicy.deprecated%",
          "description": "%config.fileWritePolicy%"
        },
        "plaitcode.commandPolicy": {
          "type": "string",
          "scope": "machine",
          "enum": [
            "allow",
            "ask",
            "deny"
          ],
          "default": "ask",
          "deprecationMessage": "%config.commandPolicy.deprecated%",
          "description": "%config.commandPolicy%"
        },
        "plaitcode.dangerousCommandPolicy": {
          "type": "string",
          "scope": "machine",
          "enum": [
            "allow",
            "ask",
            "deny"
          ],
          "enumDescriptions": [
            "%config.dangerousCommandPolicy.enum0%",
            "%config.dangerousCommandPolicy.enum1%",
            "%config.dangerousCommandPolicy.enum2%"
          ],
          "default": "ask",
          "deprecationMessage": "%config.dangerousCommandPolicy.deprecated%",
          "description": "%config.dangerousCommandPolicy%"
        },
        "plaitcode.sensitiveFilePolicy": {
          "type": "string",
          "scope": "machine",
          "enum": [
            "allow",
            "ask",
            "deny"
          ],
          "enumDescriptions": [
            "%config.sensitiveFilePolicy.enum0%",
            "%config.sensitiveFilePolicy.enum1%",
            "%config.sensitiveFilePolicy.enum2%"
          ],
          "default": "deny",
          "deprecationMessage": "%config.sensitiveFilePolicy.deprecated%",
          "description": "%config.sensitiveFilePolicy%"
        },
        "plaitcode.allowSensitiveFiles": {
          "type": "boolean",
          "default": false,
          "deprecationMessage": "%config.allowSensitiveFiles.deprecated%",
          "description": "%config.allowSensitiveFiles%",
          "scope": "machine"
        },
        "plaitcode.allowDangerousCommands": {
          "type": "boolean",
          "default": false,
          "deprecationMessage": "%config.allowDangerousCommands.deprecated%",
          "description": "%config.allowDangerousCommands%",
          "scope": "machine"
        },
        "plaitcode.maxReadBytes": {
          "type": "number",
          "default": 512000,
          "minimum": 16384,
          "maximum": 5242880,
          "description": "%config.maxReadBytes%",
          "scope": "machine"
        },
        "plaitcode.maxToolOutputBytes": {
          "type": "number",
          "default": 200000,
          "minimum": 16384,
          "maximum": 2097152,
          "description": "%config.maxToolOutputBytes%",
          "scope": "machine"
        },
        "plaitcode.maxCommandSeconds": {
          "type": "number",
          "default": 120,
          "minimum": 5,
          "maximum": 900,
          "description": "%config.maxCommandSeconds%",
          "scope": "machine"
        },
        "plaitcode.auditRetentionDays": {
          "type": "number",
          "default": 30,
          "minimum": 0,
          "maximum": 365,
          "description": "%config.auditRetentionDays%",
          "scope": "machine"
        },
        "plaitcode.language": {
          "type": "string",
          "enum": [
            "auto",
            "zh",
            "en"
          ],
          "enumDescriptions": [
            "%config.language.enum0%",
            "%config.language.enum1%",
            "%config.language.enum2%"
          ],
          "default": "auto",
          "description": "%config.language%"
        },
        "plaitcode.lanSync.enabled": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "记住连接状态：开启后每次启动自动恢复到上次的连接（**不需要手工操作**，正常流程是点状态栏的「连接另一台设备」）。"
        },
        "plaitcode.lanSync.port": {
          "type": "number",
          "default": 47821,
          "markdownDescription": "局域网同步使用的端口（TCP + UDP 发现）。两台设备必须一致。"
        },
        "plaitcode.lanSync.pairingCode": {
          "type": "string",
          "default": "",
          "markdownDescription": "（高级，可留空）固定配对码。留空时用「对方点允许」的方式确认，正常流程不需要填。"
        },
        "plaitcode.lanSync.deviceName": {
          "type": "string",
          "default": "",
          "markdownDescription": "这台设备在队友眼里的名字。留空自动使用「主机名 · 系统」。"
        },
        "plaitcode.mobile.enabled": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "允许同一 WiFi 下的手机用浏览器指挥这台电脑（发需求、回答追问、看进度）。打开后从「手机遥控」窗口扫码进入。"
        },
        "plaitcode.mobile.allowApproval": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "允许在手机上批准工具授权（命令、写文件）。关掉后手机只能看和说话，授权仍需在电脑上点。"
        }
      }
    }
  },
  "scripts": {
    "check": "tsc -p ./ --noEmit",
    "compile": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "test": "npm run compile && node --test out/test/*.test.js",
    "package": "npm run compile && node scripts/third-party-notices.mjs && npx @vscode/vsce package --no-dependencies",
    "vscode:prepublish": "npm run compile",
    "notices": "node scripts/third-party-notices.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/vscode": "^1.106.0",
    "@vscode/vsce": "4.0.0",
    "esbuild": "^0.28.0",
    "typescript": "^5.7.0"
  },
  "dependencies": {
    "defuddle": "^0.19.6"
  }
}
